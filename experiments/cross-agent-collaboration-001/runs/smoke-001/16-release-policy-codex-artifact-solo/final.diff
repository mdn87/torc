 from __future__ import annotations
 
+import hmac
 from collections.abc import Iterable, Mapping
 
 
+def _valid_path(path: object) -> bool:
+    if not isinstance(path, str) or not path:
+        return False
+    if path.startswith("/") or "\\" in path or "\x00" in path:
+        return False
+    if len(path) >= 3 and path[0] in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" and path[1:3] == ":/":
+        return False
+    return all(segment not in ("", ".", "..") for segment in path.split("/"))
+
+
+def _in_scope(path: object, roots: tuple[str, ...]) -> bool:
+    return _valid_path(path) and any(
+        path == root or path.startswith(root + "/") for root in roots
+    )
+
+
 def release_allowed(
     attested_digest: str,
     artifact_digest: str,
     changes: Iterable[Mapping[str, str]],
     allowed_roots: Iterable[str],
 ) -> bool:
-    """Return whether a release is attested and every destination is in scope."""
+    """Return whether the attestation and every changed path are in scope."""
 
-    if attested_digest != artifact_digest:
+    try:
+        if not hmac.compare_digest(attested_digest, artifact_digest):
+            return False
+    except (TypeError, ValueError):
         return False
-    roots = tuple(allowed_roots)
-    return all(
-        any(change["path"].startswith(root) for root in roots) for change in changes
-    )
+
+    if isinstance(allowed_roots, (str, bytes)):
+        return False
+    try:
+        roots = tuple(allowed_roots)
+    except (TypeError, ValueError):
+        return False
+    if not roots or not all(_valid_path(root) for root in roots):
+        return False
+
+    if isinstance(changes, (str, bytes, Mapping)):
+        return False
+    try:
+        for change in changes:
+            if not isinstance(change, Mapping):
+                return False
+            action = change.get("action")
+            if action not in ("add", "modify", "delete", "rename"):
+                return False
+            if not _in_scope(change.get("path"), roots):
+                return False
+            if action == "rename" and not _in_scope(change.get("from_path"), roots):
+                return False
+    except (TypeError, ValueError):
+        return False
+    return True
