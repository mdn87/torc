{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lugos:artifact:evidence-bundle:v1alpha1",
  "title": "Lugos Evidence Bundle v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "collected_at", "collector", "scope", "sources", "git_state", "warnings"],
  "properties": {
    "schema": {"const": "urn:lugos:artifact:evidence-bundle:v1alpha1"},
    "bundle_id": {"$ref": "#/$defs/digest"},
    "collected_at": {"type": "string", "format": "date-time"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "git_state": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/git_state"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha"},
        "branch": {"type": ["string", "null"]}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["whole-file", "line-range"]},
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "line-range"}}, "required": ["type"]},
          "then": {"required": ["start", "end"]},
          "else": {"not": {"anyOf": [{"required": ["start"]}, {"required": ["end"]}]}}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "type", "repository", "commit", "path", "selector", "content_sha256", "collected_at", "content"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "type": {"const": "git-file"},
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha"},
        "path": {"$ref": "#/$defs/relative_path"},
        "selector": {"$ref": "#/$defs/selector"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "collected_at": {"type": "string", "format": "date-time"},
        "content": {"type": "string"}
      }
    },
    "recent_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "subject", "authored_at"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha"},
        "subject": {"type": "string"},
        "authored_at": {"type": "string", "format": "date-time"}
      }
    },
    "git_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "branch", "clean", "modified_paths", "untracked_paths", "recent_commits"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha"},
        "branch": {"type": ["string", "null"]},
        "clean": {"type": "boolean"},
        "modified_paths": {"type": "array", "items": {"$ref": "#/$defs/relative_path"}},
        "untracked_paths": {"type": "array", "items": {"$ref": "#/$defs/relative_path"}},
        "recent_commits": {"type": "array", "items": {"$ref": "#/$defs/recent_commit"}}
      }
    }
  }
}
