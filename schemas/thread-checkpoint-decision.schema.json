{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/torc/schemas/thread-checkpoint-decision-v1.json",
  "title": "TORC thread checkpoint decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "thread_id",
    "lineage_id",
    "checkpoint_ref",
    "checkpoint_sha256",
    "disposition",
    "expected_accepted_checkpoint_ref",
    "authority",
    "policy_version",
    "reason_codes",
    "evidence_refs",
    "decided_at",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"$ref": "#/$defs/id"},
    "thread_id": {"$ref": "#/$defs/id"},
    "lineage_id": {"$ref": "#/$defs/id"},
    "checkpoint_ref": {"$ref": "#/$defs/id"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "disposition": {"enum": ["accepted", "rejected"]},
    "expected_accepted_checkpoint_ref": {
      "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_id", "lease_id", "lineage_head_revision_id"],
      "properties": {
        "activation_id": {"$ref": "#/$defs/id"},
        "lease_id": {"$ref": "#/$defs/id"},
        "lineage_head_revision_id": {"$ref": "#/$defs/id"}
      }
    },
    "policy_version": {"$ref": "#/$defs/id"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonical_payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonical_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
