{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/schemas/experiment-worker-run.schema.json",
  "title": "Measured experiment worker run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "transport",
    "model",
    "effort",
    "harness_version",
    "role",
    "session",
    "command",
    "prompt_sha256",
    "started_at",
    "completed_at",
    "timing",
    "exit_status",
    "timed_out",
    "stdout_sha256",
    "stderr_sha256",
    "event_count",
    "malformed_event_count",
    "usage",
    "control_preflight"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"enum": ["codex", "claude-code"]},
    "transport": {"enum": ["native", "wsl"]},
    "model": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "role": {"enum": ["implementer", "critic"]},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requested_id", "observed_id"],
      "properties": {
        "mode": {"enum": ["fresh-ephemeral", "fresh-persistent", "resume"]},
        "requested_id": {"type": ["string", "null"]},
        "observed_id": {"type": ["string", "null"]}
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup_ms", "time_to_first_output_ms", "completion_ms"],
      "properties": {
        "startup_ms": {"type": "number", "minimum": 0},
        "time_to_first_output_ms": {"type": ["number", "null"], "minimum": 0},
        "completion_ms": {"type": "number", "minimum": 0}
      }
    },
    "exit_status": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "event_count": {"type": "integer", "minimum": 0},
    "malformed_event_count": {"type": "integer", "minimum": 0},
    "usage": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "supplied",
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens",
        "output_tokens",
        "reported_fields",
        "unreported_fields",
        "provider_usage"
      ]
    },
    "control_preflight": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
