{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lugos:artifact:acceptance-receipt:v1alpha1",
  "title": "Lugos Project Snapshot Acceptance Receipt v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "artifact_id", "evidence_bundle_id", "validated_at", "validator", "status", "checks", "warnings", "errors"],
  "properties": {
    "schema": {"const": "urn:lugos:artifact:acceptance-receipt:v1alpha1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "artifact_id": {"$ref": "#/$defs/digest"},
    "evidence_bundle_id": {"$ref": "#/$defs/digest"},
    "validated_at": {"type": "string", "format": "date-time"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["accepted", "rejected"]},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]}, "then": {"properties": {"errors": {"maxItems": 0}, "checks": {"not": {"contains": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}}}}}},
    {"if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]}, "then": {"properties": {"errors": {"minItems": 1}, "checks": {"contains": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
