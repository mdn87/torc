{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/torc/schemas/lineage-revision-v1.json",
  "title": "TORC lineage revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "revision_id",
    "parent_revision_ids",
    "created_at",
    "event_type",
    "actor",
    "canonical_state",
    "evidence_refs",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "lineage_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/id"},
    "parent_revision_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "event_type": {
      "enum": [
        "lineage_created",
        "checkpoint",
        "self_model_revised",
        "handoff_prepared",
        "handoff_accepted",
        "handoff_rejected",
        "rollback_applied",
        "branch_created",
        "lineage_retired"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "activation_id", "substrate_id"],
      "properties": {
        "kind": {"enum": ["operator", "activation", "system"]},
        "activation_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "substrate_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "canonical_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "self_model",
        "goals",
        "commitments",
        "constraints",
        "open_work",
        "uncertainties",
        "artifact_refs",
        "memory_refs"
      ],
      "properties": {
        "identity": {"type": "object"},
        "self_model": {"type": "object"},
        "goals": {"type": "array", "items": {"type": "string"}},
        "commitments": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "open_work": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "memory_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "rollback_context": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_revision_id", "target_revision_sha256", "rationale", "initiated_by", "evidence_refs", "source_authority"],
          "properties": {
            "target_revision_id": {"$ref": "#/$defs/id"},
            "target_revision_sha256": {"$ref": "#/$defs/sha256"},
            "rationale": {"type": "string", "minLength": 1},
            "initiated_by": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {"kind": {"const": "operator"}, "ref": {"$ref": "#/$defs/id"}}
            },
            "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "source_authority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lineage_head_revision_id", "activation_id", "lease_id"],
              "properties": {
                "lineage_head_revision_id": {"$ref": "#/$defs/id"},
                "activation_id": {"$ref": "#/$defs/id"},
                "lease_id": {"$ref": "#/$defs/id"}
              }
            }
          }
        }
      ]
    },
    "branch_origin": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_lineage_id", "source_revision_id", "source_revision_sha256", "source_activation_id", "source_lease_id", "rationale", "initiated_by", "target_assignment_ref", "evidence_refs", "child_authority"],
          "properties": {
            "source_lineage_id": {"$ref": "#/$defs/id"},
            "source_revision_id": {"$ref": "#/$defs/id"},
            "source_revision_sha256": {"$ref": "#/$defs/sha256"},
            "source_activation_id": {"$ref": "#/$defs/id"},
            "source_lease_id": {"$ref": "#/$defs/id"},
            "rationale": {"type": "string", "minLength": 1},
            "initiated_by": {"type": "object", "additionalProperties": false, "required": ["kind", "ref"], "properties": {"kind": {"const": "operator"}, "ref": {"$ref": "#/$defs/id"}}},
            "target_assignment_ref": {"$ref": "#/$defs/id"},
            "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "child_authority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["activation_id", "lease_id", "substrate_id"],
              "properties": {"activation_id": {"$ref": "#/$defs/id"}, "lease_id": {"$ref": "#/$defs/id"}, "substrate_id": {"$ref": "#/$defs/id"}}
            }
          }
        }
      ]
    },
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "rollback_applied"}}, "required": ["event_type"]},
      "then": {"required": ["rollback_context"], "properties": {"rollback_context": {"type": "object"}}},
      "else": {"properties": {"rollback_context": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "branch_created"}}, "required": ["event_type"]},
      "then": {"required": ["branch_origin"], "properties": {"branch_origin": {"type": "object"}}},
      "else": {"properties": {"branch_origin": {"type": "null"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonical_payload_sha256", "previous_revision_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonical_payload_sha256": {"$ref": "#/$defs/sha256"},
        "previous_revision_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    }
  }
}
